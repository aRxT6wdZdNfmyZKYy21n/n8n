# ==============================================================================
# n8n Self-Hosted Edition - Environment Configuration
# ==============================================================================
# Скопируйте этот файл в .env и настройте под ваши нужды
# ==============================================================================

# ==============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ==============================================================================

# Хост и порт n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# URL для webhook (измените на ваш домен)
WEBHOOK_URL=http://localhost:5678/

# ==============================================================================
# БЕЗОПАСНОСТЬ (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ!)
# ==============================================================================

# Ключ шифрования (32 символа) - ОБЯЗАТЕЛЬНО измените!
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here

# JWT секрет - ОБЯЗАТЕЛЬНО измените!
N8N_JWT_SECRET=your_jwt_secret_here

# ==============================================================================
# БАЗА ДАННЫХ
# ==============================================================================

# Тип базы данных (postgresdb, mysqldb, sqlite)
DB_TYPE=postgresdb

# PostgreSQL настройки
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n_password
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=false

# ==============================================================================
# SELF-HOSTED НАСТРОЙКИ
# ==============================================================================

# Self-hosted режим (всегда true)
N8N_SELF_HOSTED=true

# Отключить телеметрию (всегда true)
N8N_DISABLE_TELEMETRY=true

# Включить все Enterprise функции (всегда true)
N8N_ENABLE_ALL_FEATURES=true

# Отключить Community Nodes (всегда true)
N8N_DISABLE_COMMUNITY_NODES=true

# Отключить проверку обновлений (всегда true)
N8N_DISABLE_VERSION_CHECK=true

# ==============================================================================
# ЛОГИРОВАНИЕ
# ==============================================================================

# Уровень логирования (error, warn, info, debug)
N8N_LOG_LEVEL=info

# Вывод логов (console, file, both)
N8N_LOG_OUTPUT=console,file

# ==============================================================================
# ПРОИЗВОДИТЕЛЬНОСТЬ
# ==============================================================================

# Режим выполнения (regular, queue)
EXECUTIONS_MODE=regular

# Таймауты выполнения (в секундах)
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200

# Сохранение данных выполнения
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTION=true
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false

# ==============================================================================
# ФАЙЛЫ
# ==============================================================================

# Режим хранения файлов (filesystem, s3)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Настройки файловой системы
N8N_BINARY_DATA_TTL=24
N8N_BINARY_DATA_STORAGE_PATH=/home/node/.n8n/files

# ==============================================================================
# АУТЕНТИФИКАЦИЯ
# ==============================================================================

# Управление пользователями
N8N_USER_MANAGEMENT_DISABLED=false

# Настройки сессий
N8N_SESSION_LIFETIME=168
N8N_SESSION_COOKIE_SECURE=true
N8N_SESSION_COOKIE_SAME_SITE=strict
N8N_SESSION_COOKIE_HTTP_ONLY=true

# ==============================================================================
# ИНТЕРФЕЙС
# ==============================================================================

# Персонализация
N8N_PERSONALIZATION_ENABLED=true

# Локаль по умолчанию
N8N_DEFAULT_LOCALE=en

# Отключить UI (только API)
N8N_DISABLE_UI=false

# ==============================================================================
# ПРИМЕЧАНИЯ
# ==============================================================================

# 1. ОБЯЗАТЕЛЬНО измените N8N_ENCRYPTION_KEY и N8N_JWT_SECRET
# 2. Настройте WEBHOOK_URL на ваш домен
# 3. Выберите подходящий тип базы данных
# 4. Настройте аутентификацию под ваши нужды
# 5. Для продакшена используйте HTTPS
