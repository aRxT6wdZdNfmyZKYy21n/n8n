# n8n API (internal REST; owner credentials)
N8N_BASE_URL=http://n8n:5678
N8N_REST_PREFIX=/rest
N8N_OWNER_EMAIL=owner@company.com
N8N_OWNER_PASSWORD=secret

# LDAP / AD
LDAP_URL=ldap://dc.company.com:389
LDAP_BIND_DN=cn=ldap-sync,ou=Service,dc=company,dc=com
LDAP_BIND_PASSWORD=secret
LDAP_BASE_DN=dc=company,dc=com
# Semicolon-separated list of AD group DNs or names to consider (users in these groups are allowed)
# Use ';' because DNs contain commas.
LDAP_GROUPS=CN=n8n-users,OU=Groups,DC=company,DC=com;CN=n8n-admins,OU=Groups,DC=company,DC=com
# Optional: user filter (e.g. only non-disabled accounts)
LDAP_USER_FILTER=(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2))

# Map AD group name or DN to n8n global role
# Example: {"n8n-users": "global:member", "n8n-admins": "global:admin"}
GROUP_ROLE_MAP={"n8n-users": "global:member", "n8n-admins": "global:admin"}

# Sync interval (seconds)
SYNC_INTERVAL_SECONDS=300
